{
    "name": "nhrsmm/smart-media-manager",
    "description": "AI-powered WordPress media manager with virtual folders, smart search, and one-click alt text generation.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Nazmul Hasan Robin",
            "email": "robin.sust08@gmail.com"
        }
    ],
    "require": {},
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nhrsmm\\SmartMediaManager\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nhrsmm\\SmartMediaManager\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test:unit": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
